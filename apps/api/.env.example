# Never put real secrets in this file.
# Configure these values in Render Environment Variables.
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER>/<DATABASE>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ADMIN_EMAIL=your-admin-email@example.com
NODE_ENV=production
API_URL=https://arcange-portfolio-api.onrender.com
WEB_URL=https://arcange-portfolio.vercel.app
ADMIN_URL=https://arcange-portfolio-admin.vercel.app
PORT=5000
